---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecialistsSlider from '../components/SpecialistsSlider.astro';
import { Image } from 'astro:assets';
import officeTeam from '../assets/photos/two-women-reviewing-printout.jpg';
import portraitBookkeeping from '../assets/photos/blonde-grey-blazer-portrait-arms-crossed.jpg';
import portraitTaxAdvisory from '../assets/photos/floral-suit-portrait-hand-in-pocket.jpg';
import portraitPayroll from '../assets/photos/grey-blazer-portrait-arms-crossed.jpg';
import portraitLedgers from '../assets/photos/beige-blazer-portrait-curly-hair.jpg';
import portraitSocialSecurity from '../assets/photos/olive-blazer-portrait-hands-on-hips.jpg';
import portraitFlatRate from '../assets/photos/black-suit-portrait-hand-in-pocket.jpg';
import portraitVat from '../assets/photos/white-blazer-glasses-portrait.jpg';
import portraitAnalysis from '../assets/photos/black-blazer-portrait-long-hair.jpg';
import portraitFrontDesk from '../assets/photos/black-blazer-white-trousers-portrait.jpg';
import portraitAssistant from '../assets/photos/black-shirt-portrait-arms-crossed.jpg';

const MARQUEE_REPEATS = 3;
const DASH_LENGTH = 'clamp(3.5rem,9vw,11rem)';
const DASH_THICKNESS = 'clamp(0.3rem,0.8vw,1rem)';

const specialists = [
  {
    name: 'Iwona Mazur',
    department: 'Założycielka biura',
    bio: 'Od 2002 roku prowadzi biuro i pilnuje wszystkiego, co się w nim dzieje. Jako doradca podatkowy pomaga też klientom przy umowach i zmianie formy opodatkowania.',
    photo: portraitTaxAdvisory,
    photoFocus: '41.2% 12.1%',
    photoZoom: 1.6,
    photoAlt: 'Iwona Mazur',
  },
  {
    name: 'Ewelina Tomaszek',
    department: 'Kierowniczka działu księgowości',
    bio: 'Pilnuje przede wszystkim ksiąg handlowych, a na koniec roku przygotowuje sprawozdania finansowe. Rozdziela zadania w dziale i sprawdza pracę pozostałych osób.',
    photo: portraitPayroll,
    photoFocus: '44.7% 17.5%',
    photoZoom: 1.6,
    photoAlt: 'Ewelina Tomaszek',
  },
  {
    name: 'Klaudia Barszcz',
    department: 'Księgowa',
    bio: 'Weryfikuje i księguje dokumenty oraz rozlicza transakcje. Kontaktuje się z klientami i urzędami skarbowymi, a przy deklaracjach podatkowych pomaga reszcie zespołu.',
    photo: portraitBookkeeping,
    photoFocus: '42% 12.1%',
    photoZoom: 1.6,
    photoAlt: 'Klaudia Barszcz',
  },
  {
    name: 'Patrycja Bukowska',
    department: 'Księgowa',
    bio: 'Zajmuje się kadrami i płacami, od dokumentacji pracowniczej po wynagrodzenia i rozliczenia z ZUS. Pilnuje terminów i chętnie odpowiada na pytania klientów.',
    photo: portraitLedgers,
    photoFocus: '44.7% 12.1%',
    photoZoom: 1.6,
    photoAlt: 'Patrycja Bukowska',
  },
  {
    name: 'Kinga Okoń',
    department: 'Księgowa',
    bio: 'W dziale księgowości obsługuje dokumenty finansowe: sprawdza faktury i wprowadza dane do systemu. Prowadzi też dokumentację i pomaga w bieżących sprawach biurowych.',
    photo: portraitSocialSecurity,
    photoFocus: '50% 12.1%',
    photoZoom: 1.6,
    photoAlt: 'Kinga Okoń',
  },
  {
    name: 'Karolina Orkisz',
    department: 'Księgowa',
    bio: 'Wprowadza dokumenty klientów do programu księgowego i prowadzi ich dokumentację. Na co dzień zajmuje się też bieżącymi sprawami biura.',
    photo: portraitFlatRate,
    photoFocus: '50% 9.5%',
    photoZoom: 1.6,
    photoAlt: 'Karolina Orkisz',
  },
  {
    name: 'Kamila Baran',
    department: 'Księgowa',
    bio: 'Pomaga księgowym jako asystentka i przejmuje od nich część codziennych obowiązków. Opracowuje i wystawia faktury, a także utrzymuje kontakt z klientami.',
    photo: portraitVat,
    photoFocus: '50% 17.5%',
    photoZoom: 1.6,
    photoAlt: 'Kamila Baran',
  },
  {
    name: 'Monika Pieniążek',
    department: 'Księgowa',
    bio: 'Na co dzień jest w kontakcie przede wszystkim z klientami, ale też z urzędami. Prowadzi bieżące sprawy biura i ma oko na wszystko, co się w nim dzieje.',
    photo: portraitAnalysis,
    photoFocus: '44.7% 12.1%',
    photoZoom: 1.6,
    photoAlt: 'Monika Pieniążek',
  },
  {
    name: 'Julia Kaczor',
    department: 'Księgowa',
    bio: 'Prowadzi księgowość firm na KPiR i ryczałcie: księguje dokumenty i przygotowuje rozliczenia PIT. Gdy czegoś brakuje w dokumentach, kontaktuje się z klientem.',
    photo: portraitFrontDesk,
    photoFocus: '44.7% 13.9%',
    photoZoom: 1.6,
    photoAlt: 'Julia Kaczor',
  },
  {
    name: 'Paweł Garncarz',
    department: 'Informatyk',
    bio: 'Pracuje na zapleczu biura i dba o to, żeby codzienna praca szła sprawnie. Przygotowuje analizy i automatyzuje zadania, które wcześniej trzeba było robić ręcznie.',
    photo: portraitAssistant,
    photoFocus: '48.1% 16%',
    photoZoom: 1.6,
    photoAlt: 'Paweł Garncarz',
  },
];

---
<BaseLayout
  title="O nas"
  description="Biuro rachunkowe w Dębicy z ponad 20-letnim doświadczeniem. Dziesięć osób w zespole i ponad 90 firm, którym prowadzimy księgowość, kadry i podatki."
>
  <section class="flex min-h-screen flex-col px-[2vw] pt-40 max-lg:px-[4vw] max-lg:pt-28">
    <div class="-mx-[2vw] overflow-hidden pt-[0.5vw] pb-[3.6vw] -mt-[0.5vw] -mb-[1.6vw] max-lg:-mx-[4vw] max-lg:pt-[0.6vw] max-lg:pb-[4.2vw] max-lg:-mt-[0.6vw] max-lg:mb-[4.8vw]" aria-hidden="true">
      <div
        class="marquee-track marquee-track--hero flex w-max items-center gap-[clamp(1rem,3vw,4rem)]"
      >
        {
          Array.from({ length: MARQUEE_REPEATS * 2 }).map(() => (
            <>
              <span class="text-trim shrink-0 font-display text-[18vw] font-medium uppercase leading-[0.85] text-ink max-lg:text-[21vw]">
                O nas
              </span>
              <span
                class="shrink-0 rounded-full bg-ink"
                style={`width:${DASH_LENGTH};height:${DASH_THICKNESS}`}
              ></span>
            </>
          ))
        }
      </div>
    </div>

    <h1 class="sr-only">O nas</h1>

    <div
      class="relative mt-auto h-[80vh] shrink-0 overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:h-auto max-lg:flex-1"
      data-image-reveal
    >
      <Image
        src={officeTeam}
        alt="Dwie księgowe sprawdzają wydruk przy biurku"
        class="parallax-img"
        data-parallax
        widths={[768, 1280, 1920, 2560, 3600]}
        sizes="(width < 64rem) 300vw, 95vw"
        loading="eager"
      />
      <div class="reveal-panel absolute inset-0 z-10"></div>
    </div>
  </section>

  <section class="mt-[4vw] px-[2vw] max-lg:mt-[8vw] max-lg:px-[4vw]">
    <p
      class="ml-auto w-[75vw] indent-[14%] font-sans text-[clamp(1.5rem,2.6vw,4.5rem)] font-medium leading-[1.12] tracking-[-0.02em] text-graphite max-lg:w-full max-lg:indent-0 max-lg:text-[clamp(1.15rem,5.4vw,2.1rem)] max-lg:leading-[1.3] max-lg:tracking-normal"
      data-words-scrub
      data-from="0.3"
      data-to="1"
      data-start="top 92%"
      data-end="bottom 68%"
    >
      Od ponad dwudziestu lat prowadzimy księgowość firm z Dębicy i całej
      Polski. Spokojnie, terminowo i z księgowym, który zna Twoją firmę.
    </p>

    <div class="ml-[20vw] mt-[6vw] flex gap-[5vw] max-lg:ml-0 max-lg:mt-[16vw] max-lg:flex-col max-lg:gap-[10vw]">
      <p
        class="flex-1 font-sans text-[clamp(0.9rem,1.05vw,1.3rem)] font-medium leading-[1.4] text-graphite max-lg:text-[clamp(0.95rem,4vw,1.5rem)] max-lg:leading-[1.35]"
        data-words-scrub
        data-from="0.2"
        data-to="1"
        data-start="top 90%"
        data-end="bottom 68%"
      >
        Biuro Rachunkowe Iwona Mazur od ponad dwudziestu lat prowadzi księgi
        firm z Dębicy i okolic. Na początku obsługiwaliśmy kilka lokalnych
        działalności i wystarczała do tego jedna księgowa przy telefonie.
        Dziś mamy ponad dziewięćdziesięciu klientów, od jednoosobowych
        działalności po spółki handlowe i zakłady produkcyjne, a w zespole
        pracuje dziesięć osób. Jedno się nie zmieniło: każdy klient ma
        swojego księgowego, który zna jego firmę i jej historię, więc pyta
        o sprawę, zanim zrobi się z niej problem.
      </p>

      <p
        class="flex-1 font-sans text-[clamp(0.9rem,1.05vw,1.3rem)] font-medium leading-[1.4] text-graphite max-lg:text-[clamp(0.95rem,4vw,1.5rem)] max-lg:leading-[1.35]"
        data-words-scrub
        data-from="0.2"
        data-to="1"
        data-start="top 90%"
        data-end="bottom 68%"
      >
        W biurze prowadzimy pełną księgowość i księgi przychodów i rozchodów,
        kadry i płace oraz doradztwo podatkowe. Rozliczamy VAT krajowy
        i transakcje zagraniczne oraz przygotowujemy sprawozdania finansowe. Pracujemy
        w Comarch Optima i w elektronicznym obiegu dokumentów, więc do
        współpracy nie trzeba przyjeżdżać do biura. Firmę z drugiego końca
        Polski obsługujemy tak samo jak tę z Dębicy.
      </p>
    </div>
  </section>

  <section class="relative mt-[12vw] h-[520vh] max-lg:hidden" data-horizontal>
    <h2
      class="px-[2vw] font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-graphite"
      data-reveal-lines
    >
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">Poznaj nasz</span></span>
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">zespół</span></span>
    </h2>

    <div class="sticky top-0 flex h-screen flex-col justify-center overflow-hidden">
      <div
        class="flex w-max items-start gap-[1.5vw] pl-[52vw] pr-[2vw] will-change-transform"
        data-horizontal-track
        data-rise
      >
        {
          specialists.map(({ name, department, bio, photo, photoFocus, photoZoom, photoAlt }) => (
            <article
              class="flex aspect-square w-[clamp(18rem,27vw,33rem)] shrink-0 flex-col justify-between bg-graphite p-[clamp(1.5rem,2.2vw,3rem)]"
              data-rise-item
            >
              <div class="flex items-center gap-[clamp(1rem,1.4vw,2rem)]">
                <div class="aspect-square w-[clamp(4rem,6.5vw,8.5rem)] shrink-0 overflow-hidden rounded-full bg-placeholder">
                  <Image
                    src={photo}
                    alt={photoAlt}
                    class="h-full w-full object-cover"
                    style={`object-position: ${photoFocus}; transform-origin: ${photoFocus}; transform: scale(${photoZoom})`}
                    widths={[220, 440, 700]}
                    sizes="19vw"
                  />
                </div>

                <div class="min-w-0">
                  <p class="font-sans text-[clamp(1.05rem,1.4vw,1.7rem)] font-medium uppercase leading-[1.15] text-canvas">
                    {name}
                  </p>
                  <p class="mt-[clamp(0.2rem,0.35vw,0.5rem)] font-sans text-[clamp(0.85rem,1.1vw,1.3rem)] font-normal leading-[1.2] text-canvas/60">
                    {department}
                  </p>
                </div>
              </div>

              <p class="mt-[clamp(1.5rem,2vw,3rem)] font-sans text-[clamp(1rem,1.25vw,1.5rem)] font-normal leading-[1.35] text-canvas/85">
                {bio}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SpecialistsSlider specialists={specialists} headingLines={['Poznaj nasz', 'zespół']} />

  <section class="relative mt-[12vw] h-[320vh] max-lg:mt-[20vw] max-lg:h-[240vh]" data-headline-pin data-stagger="0.15" data-hold="1">
    <div class="sticky top-0 h-screen overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center px-[2vw] max-lg:px-[4vw]"
        data-headline-group
      >
        <h2 class="text-center font-display text-[clamp(3rem,8vw,10rem)] font-medium uppercase leading-[1] text-graphite">
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">Masz pytania?</span></span>
        </h2>
      </div>

      <div
        class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center px-[2vw] max-lg:px-[4vw]"
        data-headline-group
        data-stays
      >
        <h2 class="text-center font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-graphite max-lg:text-[clamp(1.4rem,7vw,2.75rem)]">
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">Umów się na darmową</span></span>
          <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">konsultację online</span></span>
        </h2>

        <div class="pointer-events-auto flex flex-col items-center" data-headline-extra>
          <p
            class="mt-[2vw] max-w-[42vw] text-center font-sans text-[clamp(0.95rem,1.1vw,1.25rem)] font-medium leading-[1.35] text-graphite max-lg:mt-[3vh] max-lg:max-w-none"
            data-extra-words
          >
            Rozmowa trwa trzydzieści minut i do niczego nie zobowiązuje.
            Przejrzymy Twoją obecną księgowość i powiemy, co da się w niej uprościć.
          </p>

          <span class="mt-[clamp(1rem,1.4vw,2rem)] flex overflow-hidden max-lg:mt-[3vh]">
            <a
              href="#"
              class="extra-line group relative z-10 inline-flex w-fit cursor-pointer items-center gap-[clamp(1rem,1.4vw,2rem)] overflow-hidden whitespace-nowrap rounded-full border-2 border-transparent bg-ink py-[clamp(0.75rem,0.9vw,1.15rem)] pl-[clamp(1.5rem,2.2vw,3rem)] pr-[clamp(0.75rem,1.1vw,1.5rem)] text-canvas transition-colors duration-700 hover:border-ink max-lg:gap-[4vw] max-lg:whitespace-normal max-lg:py-[3vw] max-lg:pl-[5vw] max-lg:pr-[3vw]"
              aria-haspopup="dialog"
              data-open-form
            >
              <span class="relative z-10 font-display text-[clamp(1rem,1.15vw,1.375rem)] font-normal uppercase transition-all duration-[400ms] group-hover:translate-x-[1.2vw] group-hover:text-ink max-lg:text-[0.85rem]">Umów się na konsultację</span>
              <span class="relative z-0 flex h-[clamp(1.75rem,2vw,2.75rem)] w-[clamp(1.75rem,2vw,2.75rem)] shrink-0 rounded-full bg-canvas transition-transform duration-700 ease-out group-hover:duration-[1600ms] group-hover:scale-[55]"></span>
            </a>
          </span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
