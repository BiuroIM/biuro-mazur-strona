---
import BaseLayout from '../layouts/BaseLayout.astro';
import { email, registry } from '../data/contact.js';
import { Image } from 'astro:assets';
import servicesHero from '../assets/photos/open-space-reviewing-screen.jpg';
import accountingPhoto from '../assets/photos/accountant-with-binder-at-desk.jpg';
import payrollPhoto from '../assets/photos/curly-haired-accountant-smiling-at-desk.jpg';
import taxPhoto from '../assets/photos/floral-suit-advising-client.jpg';
import closingPhoto from '../assets/photos/conversation-by-logo-wall.jpg';

const MARQUEE_REPEATS = 3;
const DASH_LENGTH = 'clamp(3.5rem,9vw,11rem)';
const DASH_THICKNESS = 'clamp(0.3rem,0.8vw,1rem)';

const serviceGroups = [
  {
    title: ['Księgowość'],
    lead: 'Od księgi przychodów i rozchodów po bilans spółki.',
    photo: accountingPhoto,
    photoAlt: 'Księgowa z segregatorem przy biurku',
    services: [
      {
        name: 'Pełna księgowość',
        lead: 'Księgi rachunkowe spółek',
        description:
          'Prowadzimy księgi rachunkowe spółek. Plan kont układamy pod Twoją działalność, pilnujemy środków trwałych i rozrachunków z kontrahentami. Gdy chcesz zobaczyć, jak firma stoi, przygotowujemy raport.',
      },
      {
        name: 'Księga przychodów i rozchodów',
        lead: 'Dla JDG i spółek cywilnych',
        description:
          'Dokumenty księgujemy na bieżąco, więc wysokość zaliczki na podatek znasz przed terminem, a nie w dniu płatności. Przy okazji sprawdzamy, co możesz wrzucić w koszty i czy nie zbliżasz się do limitów.',
      },
      {
        name: 'Ewidencja ryczałtowa',
        lead: 'Dla firm na ryczałcie',
        description:
          'Każdy przychód ma swoją stawkę ryczałtu i to my pilnujemy, żeby była właściwa. Podatek liczymy co miesiąc. Przed końcem roku siadamy do liczb i sprawdzamy, czy ryczałt nadal Ci się opłaca.',
      },
      {
        name: 'Ewidencja VAT',
        lead: 'Rejestry sprzedaży i zakupu',
        description:
          'Kontrahentów sprawdzamy na białej liście, a przy każdej fakturze kosztowej patrzymy, w którym miesiącu możesz odliczyć VAT. Korekty księgujemy w tym okresie, którego wymagają przepisy.',
      },
      {
        name: 'Pliki JPK',
        lead: 'JPK_V7 i pliki z ksiąg',
        description:
          'JPK_V7 wysyłamy w Twoim imieniu, z właściwymi oznaczeniami i na czas, żeby urząd nie miał o co pytać. Od rozliczenia za 2026 rok urząd dostaje też pliki JPK z ksiąg. Te również przygotujemy.',
      },
      {
        name: 'Sprawozdania finansowe',
        lead: 'Bilans i rachunek zysków i strat',
        description:
          'Po zamknięciu roku dostajesz bilans, rachunek zysków i strat oraz informację dodatkową w formacie, którego wymaga KRS. Przypominamy o terminie zatwierdzenia i pilnujemy, żeby każdy członek zarządu podpisał sprawozdanie elektronicznie.',
      },
    ],
  },
  {
    title: ['Kadry, płace', 'i ZUS'],
    lead: 'Umowy, wypłaty i składki Twoich pracowników.',
    photo: payrollPhoto,
    photoAlt: 'Uśmiechnięta księgowa przy biurku',
    services: [
      {
        name: 'Kadry',
        lead: 'Umowy, akta i czas pracy',
        description:
          'Zatrudniasz pierwszą osobę albo kolejną? Przygotujemy umowę, założymy akta osobowe i poprowadzimy ewidencję czasu pracy. Pozostałe dokumenty pracownicze też są po naszej stronie i pilnujemy, żeby zgadzały się z prawem pracy.',
      },
      {
        name: 'Płace',
        lead: 'Wynagrodzenia, urlopy i zwolnienia',
        description:
          'Co miesiąc liczymy wynagrodzenia i przygotowujemy listę płac. Urlop, chorobowe albo inne świadczenie uwzględniamy w wypłacie. Deklaracje i rozliczenia podatkowe za pracowników też robimy my.',
      },
      {
        name: 'ZUS',
        lead: 'Zgłoszenia, składki i zaświadczenia A1',
        description:
          'Zgłaszamy do ZUS Ciebie i Twoich pracowników, a gdy ktoś odchodzi, wyrejestrowujemy go. Liczymy składki i co miesiąc składamy deklaracje. Gdy Ty albo pracownik jedziecie do pracy w innym kraju UE, składamy wniosek o zaświadczenie A1.',
      },
    ],
  },
  {
    title: ['Podatki', 'i urzędy'],
    lead: 'Doradztwo podatkowe i rozliczenia roczne.',
    photo: taxPhoto,
    photoAlt: 'Doradczyni omawia sprawę z klientką',
    services: [
      {
        name: 'Doradztwo podatkowe',
        lead: 'Doradca podatkowy z KIDP',
        description: `Biuro prowadzi Iwona Mazur, doradca podatkowy nr ${registry.taxAdvisorNumber} i członek Krajowej Izby Doradców Podatkowych. O skutki podatkowe pytasz więc u nas, bez szukania kancelarii z zewnątrz. Najlepiej przed decyzją: zanim podpiszesz umowę albo zmienisz formę opodatkowania. Pod koniec roku liczymy, czy od stycznia nie zapłacisz mniej w innej formie. Wnioski dostajesz na piśmie.`,
      },
      {
        name: 'Deklaracje i rozliczenia roczne',
        lead: 'PIT i CIT za cały rok',
        description:
          'Po zamknięciu roku przygotowujemy Twój PIT albo CIT i wysyłamy go elektronicznie. Wcześniej przeglądamy ulgi i odliczenia, żeby nie przepadło nic, co Ci przysługuje.',
      },
    ],
  },
  {
    title: ['Nowa firma'],
    lead: 'Pierwsze kroki od wyboru formy do rejestracji.',
    services: [
      {
        name: 'Zakładanie działalności i spółek',
        lead: 'Rejestracja w CEIDG albo KRS',
        description:
          'Najpierw rozmawiamy o tym, czym będziesz się zajmować, i razem wybieramy formę prawną oraz sposób opodatkowania. Potem wypełniamy wnioski do CEIDG albo KRS i zgłaszamy firmę do urzędu skarbowego i ZUS. W pierwszych miesiącach tłumaczymy każdy krok.',
      },
    ],
  },
];

const numberedGroups = serviceGroups.reduce(
  (acc, group) => {
    const services = group.services.map((service, i) => ({ ...service, number: acc.next + i }));
    acc.groups.push({ ...group, services });
    acc.next += services.length;
    return acc;
  },
  { groups: [], next: 1 }
).groups;

const standards = [
  {
    title: ['Jedna osoba', 'prowadząca'],
    description:
      'Masz swoją księgową, która zna Twoją firmę. Dzwonisz albo piszesz prosto do niej, bez przełączania między działami.',
  },
  {
    title: ['Terminy', 'po naszej stronie'],
    description:
      'Deklaracje, pliki JPK i składki ZUS mają swoje terminy. Pilnujemy ich za Ciebie, a pisma z urzędów odbieramy i odpowiadamy na nie w Twoim imieniu. Kalendarza podatkowego nie musisz znać.',
  },
  {
    title: ['Decyzje', 'z wyprzedzeniem'],
    description:
      'Zmieniają się przepisy, zbliżasz się do limitu albo trzeba wybrać formę opodatkowania na nowy rok? Dowiesz się o tym od nas wcześniej, a nie po terminie.',
  },
];

const pad = (n) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Usługi księgowe i kadrowe"
  description="Usługi biura rachunkowego w Dębicy: pełna księgowość, KPiR i ryczałt, VAT i JPK, kadry i płace, rozliczenia ZUS, doradztwo podatkowe i zakładanie firm."
>
  <section class="flex min-h-screen flex-col px-[2vw] pt-40 max-lg:px-[4vw] max-lg:pt-28">
    <div class="-mx-[2vw] overflow-hidden pt-[0.5vw] pb-[3.6vw] -mt-[0.5vw] -mb-[1.6vw] max-lg:-mx-[4vw] max-lg:pt-[0.6vw] max-lg:pb-[4.2vw] max-lg:-mt-[0.6vw] max-lg:mb-[4.8vw]" aria-hidden="true">
      <div
        class="marquee-track marquee-track--hero flex w-max items-center gap-[clamp(1rem,3vw,4rem)]"
      >
        {
          Array.from({ length: MARQUEE_REPEATS * 2 }).map(() => (
            <>
              <span class="text-trim shrink-0 font-display text-[18vw] font-medium uppercase leading-[0.85] text-ink max-lg:text-[21vw]">
                Usługi
              </span>
              <span
                class="shrink-0 rounded-full bg-ink"
                style={`width:${DASH_LENGTH};height:${DASH_THICKNESS}`}
              ></span>
            </>
          ))
        }
      </div>
    </div>

    <h1 class="sr-only">Usługi</h1>

    <div
      class="relative mt-auto h-[80vh] shrink-0 overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:h-auto max-lg:flex-1"
      data-image-reveal
    >
      <Image
        src={servicesHero}
        alt="Dwie księgowe sprawdzają dane na monitorze w open space biura"
        class="parallax-img"
        data-parallax
        widths={[768, 1280, 1920, 2560, 3600]}
        sizes="(width < 64rem) 300vw, 95vw"
        loading="eager"
      />
      <div class="reveal-panel absolute inset-0 z-10"></div>
    </div>
  </section>

  <section class="mt-[6vw] px-[2vw] max-lg:mt-[12vw] max-lg:px-[4vw]">
    <p
      class="ml-auto w-[75vw] indent-[14%] font-sans text-[clamp(1.5rem,2.6vw,4.5rem)] font-medium leading-[1.12] tracking-[-0.02em] text-graphite max-lg:w-full max-lg:indent-0 max-lg:text-[clamp(1.15rem,5.4vw,2.1rem)] max-lg:leading-[1.3] max-lg:tracking-normal"
      data-words-scrub
      data-from="0.3"
      data-to="1"
      data-start="top 92%"
      data-end="bottom 68%"
    >
      Prowadzimy księgowość, kadry i podatki firm z Dębicy i z całej Polski.
      Ty przysyłasz dokumenty, a my mówimy, ile i do kiedy zapłacić.
    </p>
  </section>

  <section
    class="mt-[10vw] grid grid-cols-[46vw_minmax(0,1fr)] gap-x-[4vw] px-[2vw] max-lg:mt-[20vw] max-lg:grid-cols-1 max-lg:px-[4vw]"
    data-photo-swap
    data-swap-even
  >
    <div class="sticky top-[10vh] h-[80vh] self-start max-lg:hidden">
      <div
        class="relative h-full overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)]"
        data-image-reveal
      >
        {
          numberedGroups.filter((group) => group.photo).map((group, groupIndex) => (
            <div
              class:list={[
                'absolute inset-0 overflow-hidden',
                groupIndex > 0 && '[clip-path:inset(100%_0%_0%_0%)]',
              ]}
              style={`z-index:${groupIndex + 1}`}
              data-photo-swap-image
            >
              <Image
                src={group.photo}
                alt={group.photoAlt}
                class="h-full w-full object-cover"
                widths={[640, 1024, 1600]}
                sizes="46vw"
                loading={groupIndex === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))
        }
        <div class="reveal-panel absolute inset-0 z-10"></div>
      </div>
    </div>

    <div class="pb-[90vh] max-lg:pb-[45vh]">
      {
        numberedGroups.map((group, groupIndex) => (
          <div
            class:list={['pt-[4vh] max-lg:pt-0', groupIndex > 0 && 'mt-[14vw] max-lg:mt-[20vw]']}
            data-photo-swap-step
          >
            {group.photo && (
              <div
                class="relative mb-[8vw] hidden h-[110vw] overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:block"
                data-image-reveal
              >
                <Image
                  src={group.photo}
                  alt={group.photoAlt}
                  class="parallax-img"
                  data-parallax
                  widths={[640, 1024, 1600]}
                  sizes="92vw"
                />
                <div class="reveal-panel absolute inset-0 z-10"></div>
              </div>
            )}

            <span class="font-counter text-[clamp(0.7rem,0.85vw,1.05rem)] font-medium uppercase tracking-[0.08em] text-graphite/55 max-lg:text-[clamp(0.7rem,3vw,0.95rem)]">
              {pad(groupIndex + 1)} / {pad(numberedGroups.length)}
            </span>

            <h2
              class="mt-[clamp(0.75rem,1vw,1.5rem)] font-display text-[clamp(2.5rem,5.5vw,7rem)] font-medium uppercase leading-[1] text-graphite max-lg:mt-[3vw] max-lg:text-[clamp(2rem,11vw,4rem)]"
              data-reveal-lines
            >
              {group.title.map((line) => (
                <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">{line}</span></span>
              ))}
            </h2>

            <p
              class="mt-[clamp(1rem,1.4vw,2rem)] max-w-[30vw] font-sans text-[clamp(1rem,1.25vw,1.6rem)] font-medium leading-[1.3] text-graphite max-lg:mt-[4vw] max-lg:max-w-none max-lg:text-[clamp(1rem,4.6vw,1.5rem)]"
              data-words-scrub
              data-from="0.3"
              data-to="1"
            >
              {group.lead}
            </p>

            <ul class="mt-[clamp(2.5rem,5vw,7rem)] border-t border-graphite/20 max-lg:mt-[10vw]">
              {group.services.map((service) => (
                <li
                  class="grid grid-cols-[3.5vw_minmax(0,1fr)] gap-x-[1.5vw] border-b border-graphite/20 py-[clamp(1.75rem,3.2vw,4.5rem)] max-lg:grid-cols-[10vw_minmax(0,1fr)] max-lg:gap-x-[3vw] max-lg:py-[8vw]"
                >
                  <span class="pt-[0.45em] font-counter text-[clamp(0.6rem,0.75vw,0.9rem)] font-medium tabular-nums text-graphite/55 max-lg:text-[clamp(0.65rem,3vw,0.9rem)]">
                    {pad(service.number)}
                  </span>

                  <div>
                    <h3 class="font-sans text-[clamp(1.25rem,2.1vw,2.7rem)] font-medium leading-[1.1] tracking-[-0.02em] text-graphite max-lg:text-[clamp(1.2rem,5.8vw,2rem)]">
                      {service.name}
                    </h3>
                    <p class="mt-[clamp(0.5rem,0.8vw,1.1rem)] font-sans text-[clamp(0.75rem,0.95vw,1.15rem)] font-medium leading-[1.5] text-graphite/45 max-lg:mt-[2vw] max-lg:text-[clamp(0.8rem,3.6vw,1.05rem)]">
                      {service.lead}
                    </p>
                    <p class="mt-[clamp(0.35rem,0.5vw,0.75rem)] max-w-[34vw] font-sans text-[clamp(0.8rem,1vw,1.2rem)] font-medium leading-[1.6] text-graphite max-lg:mt-[1.5vw] max-lg:max-w-none max-lg:text-[clamp(0.85rem,3.8vw,1.1rem)]">
                      {service.description}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <div
    class="pointer-events-none fixed inset-0 -z-10 bg-ink opacity-0"
    data-dark-bg-layer
    aria-hidden="true"
  >
  </div>

  <section
    class="mt-[20vw] px-[2vw] py-[18vh] max-lg:mt-[30vw] max-lg:px-[4vw] max-lg:py-[14vh]"
    data-dark-bg
    data-start="top 50%"
    data-end="bottom top"
  >
    <h2
      class="font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-canvas max-lg:text-[clamp(1.4rem,7vw,2.75rem)]"
      data-reveal-lines
    >
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">W każdej</span></span>
      <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">usłudze</span></span>
    </h2>

    <ol class="mt-[clamp(3rem,7vw,10rem)] border-t border-canvas/20 max-lg:mt-[12vw]">
      {
        standards.map((standard, i) => (
          <li class="grid grid-cols-[7%_45%_minmax(0,1fr)] items-start gap-x-[2vw] border-b border-canvas/20 py-[clamp(2rem,4vw,6rem)] max-lg:flex max-lg:flex-col max-lg:gap-y-[4vw] max-lg:py-[9vw]">
            <span class="pt-[0.6em] font-counter text-[clamp(0.6rem,0.75vw,0.9rem)] font-medium tabular-nums text-canvas/55 max-lg:pt-0 max-lg:text-[clamp(0.65rem,3vw,0.9rem)]">
              {pad(i + 1)}
            </span>

            <h3
              class="font-display text-[clamp(1.5rem,3.1vw,3.9rem)] font-medium uppercase leading-[1.02] text-canvas max-lg:text-[clamp(1.4rem,7vw,2.6rem)]"
              data-reveal-lines
            >
              {standard.title.map((line) => (
                <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">{line}</span></span>
              ))}
            </h3>

            <p
              class="pt-[0.5em] font-sans text-[clamp(0.95rem,1.25vw,1.6rem)] font-medium leading-[1.4] text-canvas max-lg:pt-0 max-lg:text-[clamp(1rem,4.4vw,1.4rem)]"
              data-words-scrub
              data-from="0.25"
              data-to="1"
            >
              {standard.description}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="relative mt-[12vw] h-[330vh] max-lg:mt-[20vw] max-lg:h-[160vh]"
    data-headline-pin
    data-stagger="0.15"
    data-hold="1.8"
    data-photo-in="2.6"
    data-scrub="1.2"
  >
    <div class="sticky top-0 h-screen overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center px-[2vw] max-lg:px-[4vw]"
        data-headline-group
        data-stays
      >
        <div class="flex shrink-0 flex-col items-center">
          <h2 class="text-center font-display text-[clamp(2rem,4.5vw,5.5rem)] font-medium uppercase leading-[1.05] text-graphite max-lg:text-[clamp(1.4rem,7vw,2.75rem)]">
            <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">Potrzebujesz</span></span>
            <span class="block overflow-hidden -mb-[0.15em]"><span class="headline-line block pb-[0.15em]">wyceny?</span></span>
          </h2>

          <div class="pointer-events-auto flex flex-col items-center" data-headline-extra>
            <p
              class="mt-[2vw] max-w-[32vw] text-center font-sans text-[clamp(0.95rem,1.1vw,1.25rem)] font-medium leading-[1.35] text-graphite max-lg:mt-[3vh] max-lg:max-w-[88vw]"
              style="text-wrap: balance"
              data-extra-words
            >
              Zadzwoń albo napisz na {email.label}, a przygotujemy propozycję zakresu obsługi i wycenę.
            </p>

            <span class="mt-[clamp(1rem,1.4vw,2rem)] flex overflow-hidden max-lg:mt-[3vh]">
              <a
                href="#"
                class="extra-line group relative z-10 inline-flex w-fit cursor-pointer items-center gap-[clamp(1rem,1.4vw,2rem)] overflow-hidden whitespace-nowrap rounded-full border-2 border-transparent bg-ink py-[clamp(0.75rem,0.9vw,1.15rem)] pl-[clamp(1.5rem,2.2vw,3rem)] pr-[clamp(0.75rem,1.1vw,1.5rem)] text-canvas transition-colors duration-700 hover:border-ink max-lg:gap-[4vw] max-lg:whitespace-normal max-lg:py-[3vw] max-lg:pl-[5vw] max-lg:pr-[3vw]"
                aria-haspopup="dialog"
                data-open-form
              >
                <span class="relative z-10 font-display text-[clamp(1rem,1.15vw,1.375rem)] font-normal uppercase transition-all duration-[400ms] group-hover:translate-x-[1.2vw] group-hover:text-ink max-lg:text-[0.85rem]">Napisz do nas</span>
                <span class="relative z-0 flex h-[clamp(1.75rem,2vw,2.75rem)] w-[clamp(1.75rem,2vw,2.75rem)] shrink-0 rounded-full bg-canvas transition-transform duration-700 ease-out group-hover:duration-[1600ms] group-hover:scale-[55]"></span>
              </a>
            </span>
          </div>
        </div>

        <div class="w-0 shrink-0 overflow-hidden max-lg:hidden" data-headline-photo="width">
          <div class="w-max pl-[4vw]">
            <div class="aspect-[1600/1143] w-[min(42vw,72vh)] overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)]">
              <Image
                src={closingPhoto}
                alt="Rozmowa z klientem przy ścianie z logo biura"
                class="h-full w-full object-cover"
                widths={[640, 1024, 1600]}
                sizes="42vw"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
