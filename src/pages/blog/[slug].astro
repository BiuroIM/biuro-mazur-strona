---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoverLetters from '../../components/HoverLetters.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import {
  formatDate,
  formatDateMonthFirst,
  isoDate,
  readingLabel,
  relatedPosts,
} from '../../data/blog.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

const sections = headings.filter((heading) => heading.depth === 2);
const related = relatedPosts(posts, post);
---
<BaseLayout
  title={post.data.title}
  description={post.data.lead}
  image={post.data.cover.src}
>
  <article>
    <section class="px-[2vw] pt-40 max-lg:px-[4vw] max-lg:pt-28">
      <a
        href="/blog"
        class="group inline-flex border-b-2 border-graphite/40 pb-[1px] font-display text-[clamp(0.7rem,0.85vw,1rem)] font-medium uppercase tracking-[0.03em] text-graphite/75 transition-colors duration-500 hover:border-ink hover:text-ink"
      >
        <HoverLetters text="Wróć do bloga" />
      </a>

      <div
        class="mt-[clamp(1.5rem,2.5vw,3.5rem)] flex items-center justify-center gap-[clamp(0.5rem,0.7vw,0.9rem)] font-display text-[clamp(0.6rem,0.75vw,0.9rem)] font-medium uppercase tracking-[0.03em] text-graphite/75 max-lg:mt-[6vw] max-lg:text-[clamp(0.65rem,3vw,0.95rem)]"
      >
        <span>{post.data.category}</span>
        <span class="h-[0.3em] w-[0.3em] shrink-0 rounded-full bg-graphite/40"></span>
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span class="h-[0.3em] w-[0.3em] shrink-0 rounded-full bg-graphite/40"></span>
        <span>{readingLabel(post.data.readingMinutes)}</span>
      </div>

      <h1
        class="mx-auto mt-[clamp(0.75rem,1.4vw,2rem)] w-[80vw] text-center font-display text-[clamp(2rem,5.4vw,7rem)] font-medium uppercase leading-[1.02] text-graphite max-lg:mt-[3vw] max-lg:w-full max-lg:text-[clamp(1.75rem,8.5vw,3.5rem)]"
      >
        {post.data.title}
      </h1>

      <div
        class="relative mx-auto mt-[clamp(2rem,3.5vw,5rem)] aspect-[3/2] w-[60vw] overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:mt-[8vw] max-lg:aspect-[4/3] max-lg:w-full"
        data-image-reveal
        data-delay-desktop="0.22"
      >
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          class={`parallax-img ${post.data.softParallax ? 'parallax-img--soft' : ''}`}
          data-parallax
          widths={[768, 1280, 2000]}
          sizes="(width < 64rem) 117vw, 68vw"
          loading="eager"
        />
        <div class="reveal-panel absolute inset-0 z-10"></div>
      </div>
    </section>

    <section class="relative mt-[5vw] px-[2vw] max-lg:mt-[12vw] max-lg:px-[4vw]">
      {
        sections.length > 0 && (
          <aside class="absolute inset-y-0 left-[2vw] w-[14vw] max-lg:hidden" aria-label="Spis treści">
            <div class="sticky top-[18vh]">
              <p class="font-display text-[clamp(0.6rem,0.7vw,0.85rem)] font-medium uppercase tracking-[0.03em] text-graphite/50">
                W tym wpisie
              </p>

              <ul class="mt-[clamp(0.75rem,1.1vw,1.5rem)] flex flex-col gap-[clamp(0.4rem,0.6vw,0.8rem)] border-t border-graphite/20 pt-[clamp(0.75rem,1.1vw,1.5rem)]">
                {
                  sections.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="font-sans text-[clamp(0.8rem,0.95vw,1.05rem)] font-normal leading-[1.3] text-graphite/70 transition-colors duration-500 [@media(hover:hover)]:hover:text-ink"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        )
      }

      <div
        class="post-body mx-auto w-[52vw] max-lg:w-full"
      >
        <Content />
      </div>
    </section>
  </article>

  {
    related.length > 0 && (
      <section class="mt-[10vw] px-[2vw] max-lg:mt-[20vw] max-lg:px-[4vw]">
        <div class="flex items-end justify-between gap-[2vw] max-sm:flex-col max-sm:items-start max-sm:gap-[2vh]">
          <h2
            class="font-display text-[clamp(1.5rem,2.8vw,3.5rem)] font-medium uppercase leading-[1.05] text-graphite max-lg:text-[clamp(1.3rem,6.5vw,2.5rem)]"
            data-reveal-lines
          >
            <span class="block overflow-hidden -mb-[0.15em]"><span class="reveal-line block pb-[0.15em]">Czytaj dalej</span></span>
          </h2>

          <a
            href="/blog"
            class="group inline-flex shrink-0 border-b-2 border-graphite pb-[1px] font-display text-[clamp(0.95rem,1.25vw,1.4rem)] font-medium uppercase text-graphite transition-colors duration-500 hover:border-ink hover:text-ink"
          >
            <HoverLetters text="Wszystkie wpisy" />
          </a>
        </div>

        <div class="mt-[3vw] grid grid-cols-3 gap-[2vw] max-lg:mt-[6vw] max-lg:grid-cols-2 max-lg:gap-[4vw] max-sm:grid-cols-1">
          {
            related.map((item) => (
              <a href={`/blog/${item.id}`} class="group block" data-cursor-label="Zobacz">
                <div
                  class="relative aspect-[3/2] w-full overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)]"
                  data-image-reveal
                  data-delay-desktop="0.2"
                >
                  <div class="absolute inset-0" data-photo-zoom>
                    <Image
                      src={item.data.cover}
                      alt={item.data.coverAlt}
                      class={`parallax-img ${item.data.softParallax ? 'parallax-img--soft' : ''}`}
                      data-parallax
                      widths={[480, 800, 1200]}
                      sizes="(width < 40rem) 114vw, (width < 64rem) 60vw, 38vw"
                    />
                  </div>
                  <div class="reveal-panel absolute inset-0 z-10" />
                </div>

                <div class="mt-[clamp(1rem,1.4vw,2rem)] flex items-center gap-[clamp(0.5rem,0.7vw,0.9rem)] font-sans text-[clamp(0.8rem,0.9vw,1.05rem)] font-normal text-graphite/90 max-lg:mt-[4vw] max-lg:text-[clamp(0.78rem,3.1vw,0.95rem)]">
                  <span class="h-[0.5em] w-[0.5em] shrink-0 rounded-full bg-graphite/90" aria-hidden="true"></span>
                  <time datetime={isoDate(item.data.date)}>{formatDateMonthFirst(item.data.date)}</time>
                </div>

                <h3 class="mt-[clamp(0.5rem,0.8vw,1.1rem)] font-display text-[clamp(1rem,1.5vw,1.9rem)] font-medium uppercase leading-[1.15] text-graphite transition-colors duration-500 [@media(hover:hover)]:group-hover:text-ink max-lg:mt-[2.5vw] max-lg:text-[clamp(1.05rem,4.6vw,1.6rem)]">
                  {item.data.title}
                </h3>
              </a>
            ))
          }
        </div>
      </section>
    )
  }
</BaseLayout>
