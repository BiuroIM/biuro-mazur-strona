---
import BaseLayout from '../layouts/BaseLayout.astro';
import { address, email, openingHours, phone } from '../data/contact.js';
import { Image } from 'astro:assets';
import FormFields from '../components/FormFields.astro';
import HoverLetters from '../components/HoverLetters.astro';
import accountantsDiscussingWide from '../assets/photos/three-accountants-discussing-documents.jpg';
import accountantsDiscussing from '../assets/photos/three-accountants-discussing-documents-portrait.jpg';
import { pageData } from '../data/content.js';

const MARQUEE_REPEATS = 3;
const DASH_LENGTH = 'clamp(3.5rem,9vw,11rem)';
const DASH_THICKNESS = 'clamp(0.3rem,0.8vw,1rem)';

const contactDetails = [
  { label: 'Telefon', value: phone.label, href: phone.href },
  { label: 'E-mail', value: email.label, href: email.href },
  {
    label: 'Adres',
    value: address.label,
    href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.label)}`,
    external: true,
  },
  { label: 'Godziny pracy', value: openingHours.label },
];

const content = await pageData('contactPage');
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
>
  <section class="px-[2vw] pb-[8vw] pt-40 max-lg:px-[4vw] max-lg:pb-[16vw] max-lg:pt-28">
    <div class="-mx-[2vw] overflow-hidden pt-[0.5vw] pb-[3.6vw] -mt-[0.5vw] -mb-[1.6vw] max-lg:-mx-[4vw] max-lg:pt-[0.6vw] max-lg:pb-[4.2vw] max-lg:-mt-[0.6vw] max-lg:mb-[4.8vw]" aria-hidden="true">
      <div
        class="marquee-track marquee-track--hero flex w-max items-center gap-[clamp(1rem,3vw,4rem)]"
      >
        {
          Array.from({ length: MARQUEE_REPEATS * 2 }).map(() => (
            <>
              <span class="text-trim shrink-0 font-display text-[18vw] font-medium uppercase leading-[0.85] text-ink max-lg:text-[21vw]">
                Kontakt
              </span>
              <span
                class="shrink-0 rounded-full bg-ink"
                style={`width:${DASH_LENGTH};height:${DASH_THICKNESS}`}
              ></span>
            </>
          ))
        }
      </div>
    </div>

    <h1 class="sr-only">Kontakt</h1>

    <div class="mt-[5vw] grid grid-cols-[25fr_75fr] items-start gap-[5vw] max-lg:mt-[10vw] max-lg:grid-cols-1">
      <div class="flex flex-col gap-[clamp(2rem,3vw,4rem)] max-lg:gap-[10vw]">
        <div
          class="relative aspect-[3/4] w-full overflow-hidden rounded-[clamp(1rem,1.5vw,2rem)] max-lg:aspect-[4/3]"
          data-image-reveal
        >
          <Image
            src={accountantsDiscussing}
            alt="Trzy księgowe omawiają dokumenty przy biurku w biurze"
            class="parallax-img parallax-img--soft max-lg:hidden"
            data-parallax
            widths={[480, 857]}
            sizes="25vw"
          />
          <Image
            src={accountantsDiscussingWide}
            alt="Trzy księgowe omawiają dokumenty przy biurku w biurze"
            class="parallax-img parallax-img--soft hidden max-lg:block"
            data-parallax
            widths={[640, 1024, 1536]}
            sizes="92vw"
          />
          <div class="reveal-panel absolute inset-0 z-10"></div>
        </div>

        <dl class="flex flex-col border-t border-graphite/20" data-animate="fade-up">
          {
            contactDetails.map(({ label, value, href, external }) => (
              <div class="flex flex-col gap-[clamp(0.35rem,0.5vw,0.6rem)] border-b border-graphite/20 py-[clamp(0.9rem,1.2vw,1.5rem)] max-lg:gap-[1.5vw] max-lg:py-[4vw]">
                <dt class="font-sans text-[clamp(0.7rem,0.8vw,0.95rem)] font-medium uppercase leading-[1.1] tracking-[0.08em] text-graphite/55 max-lg:text-[clamp(0.7rem,3vw,0.9rem)]">
                  {label}
                </dt>
                <dd class="font-sans text-[clamp(1rem,1.2vw,1.45rem)] font-medium leading-[1.3] text-graphite max-lg:text-[clamp(1.05rem,4.6vw,1.4rem)]">
                  {href ? (
                    <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                      {value}
                    </a>
                  ) : (
                    value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div
        class="relative w-full"
        data-form-page
        data-animate="fade-up"
      >
        <FormFields idPrefix="kontakt" surface="light" steps={false}>
          <a
            slot="after-submit"
            href="/"
            class="group relative inline-flex pb-[0.15em] font-display text-[22px] font-medium uppercase leading-none text-graphite max-sm:text-[17px]"
          >
            <HoverLetters text="Wróć na stronę główną" />

            <span
              class="absolute bottom-0 left-0 h-[2px] w-full origin-right bg-graphite transition-transform duration-300 ease-in group-hover:scale-x-0"
              aria-hidden="true"></span>
            <span
              class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-graphite transition-transform delay-300 duration-300 ease-out group-hover:scale-x-100"
              aria-hidden="true"></span>
          </a>
        </FormFields>
      </div>
    </div>
  </section>

</BaseLayout>
