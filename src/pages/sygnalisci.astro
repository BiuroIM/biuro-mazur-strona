---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'whistleblowers');
const { Content } = await render(entry);
const { title, description, documents = [] } = entry.data;
---
<BaseLayout
  title={title}
  description={description}
>
  <article>
    <section class="px-[2vw] pt-[clamp(9rem,15vw,16rem)] max-lg:px-[4vw] max-lg:pt-[clamp(7rem,40vw,11rem)]">
      <h1
        class="mx-auto w-[72vw] text-center font-display text-[clamp(1.75rem,4.8vw,6.25rem)] font-medium uppercase leading-[1.02] text-graphite max-lg:w-full max-lg:text-[clamp(1.6rem,8vw,3.25rem)]"
      >
        {title}
      </h1>
    </section>

    <section class="mt-[5vw] px-[2vw] pb-[8vw] max-lg:mt-[12vw] max-lg:px-[4vw] max-lg:pb-[20vw]">
      <div class="post-body mx-auto w-[52vw] max-lg:w-full" data-animate="fade-up">
        <Content />

        {
          documents.length > 0 && (
            <>
              <h2>Dokumenty</h2>
              <ul>
                {documents.map(({ label, file }) => (
                  <li>
                    <a href={file} target="_blank" rel="noopener">{label}</a> (PDF)
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </section>
  </article>
</BaseLayout>
