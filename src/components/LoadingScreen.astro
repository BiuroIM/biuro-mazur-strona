---
---
<div class="fixed inset-0 z-[80] overflow-hidden" aria-hidden="true" data-loader>
  <span
    class="absolute inset-y-0 left-0 w-[50.4%] origin-left bg-black"
    data-loader-half="left"></span>
  <span
    class="absolute inset-y-0 right-0 w-[50.4%] origin-right bg-black"
    data-loader-half="right"></span>

  <div class="absolute inset-0" data-loader-content>
    <span
      class="absolute bottom-[clamp(1rem,2.2vw,2.5rem)] right-[2vw] -mt-[0.04em] -mb-[0.08em] block overflow-hidden pt-[0.04em] text-[clamp(4rem,11vw,15rem)] max-lg:right-[4vw]">
      <span
        class="text-trim block pb-[0.08em] font-display font-medium leading-none text-canvas"
        data-loader-number>0</span>
    </span>

    <div class="absolute inset-x-0 bottom-0 h-[clamp(3px,0.35vw,6px)]">
      <div
        class="h-full w-full origin-left bg-canvas [transform:scaleX(0)]"
        data-loader-bar>
      </div>
    </div>
  </div>
</div>
