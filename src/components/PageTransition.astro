---
---
<div
  class="pointer-events-none fixed inset-0 z-[70] overflow-hidden"
  aria-hidden="true"
  data-transition
  transition:persist="przejscie-stron"
>
  <div class="absolute inset-0" data-transition-layer="green">
    <span
      class="absolute inset-y-0 left-0 w-[50.4%] origin-left scale-x-100 bg-canvas-deep"
      data-transition-half="left"></span>
    <span
      class="absolute inset-y-0 right-0 w-[50.4%] origin-right scale-x-100 bg-canvas-deep"
      data-transition-half="right"></span>
  </div>

  <div class="absolute inset-0" data-transition-layer="dark">
    <span
      class="absolute inset-y-0 left-0 w-[50.4%] origin-left scale-x-100 bg-ink"
      data-transition-half="left"></span>
    <span
      class="absolute inset-y-0 right-0 w-[50.4%] origin-right scale-x-100 bg-ink"
      data-transition-half="right"></span>
  </div>
</div>
