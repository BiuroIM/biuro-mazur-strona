---
interface Props {
  id: string;
  name: string;
  options: string[];
  placeholder: string;
  surface?: 'dark' | 'light';
  required?: boolean;
  triggerClasses?: string;
}

const {
  id,
  name,
  options,
  placeholder,
  surface = 'dark',
  required = false,
  triggerClasses = '',
} = Astro.props;

const onLight = surface === 'light';

const panelClasses = onLight
  ? 'border-ink/25 bg-canvas text-ink'
  : 'border-canvas/20 bg-ink text-canvas';
const optionClasses = onLight
  ? 'text-ink/85 [--select-hit:var(--color-ink)]'
  : 'text-canvas/85 [--select-hit:var(--color-canvas)]';
const dotClasses = onLight ? 'bg-ink' : 'bg-canvas';

const chevron = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-[0.9em] w-[0.9em]" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>`;
---
<div class="relative" data-select>
  <select
    id={`${id}-native`}
    name={name}
    required={required}
    tabindex="-1"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full appearance-none opacity-0"
    data-select-native
  >
    <option value="" disabled selected>{placeholder}</option>
    {options.map((option) => <option value={option}>{option}</option>)}
  </select>

  <button
    type="button"
    id={id}
    class={`flex w-full cursor-pointer items-center justify-between gap-[1em] text-left ${triggerClasses}`}
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-list`}
    data-select-trigger
  >
    <span data-select-value data-empty="true">{placeholder}</span>
    <span class="shrink-0" data-select-chevron set:html={chevron} />
  </button>

  <div
    id={`${id}-list`}
    class={`invisible absolute left-0 top-[calc(100%+clamp(0.5rem,0.8vw,1rem))] z-30 w-full max-w-[26rem] overflow-y-auto overflow-x-hidden overscroll-contain rounded-[clamp(0.5rem,0.8vw,1rem)] border py-[clamp(0.35rem,0.5vw,0.7rem)] max-lg:max-w-none max-lg:py-[2vw] opacity-0 shadow-panel ${panelClasses}`}
    role="listbox"
    aria-label={placeholder}
    data-select-list
    data-lenis-prevent
  >
    {
      options.map((option, i) => (
        <button
          type="button"
          id={`${id}-option-${i}`}
          class={`flex w-full cursor-pointer items-center gap-[clamp(0.5rem,0.8vw,0.9rem)] px-[clamp(0.9rem,1.2vw,1.5rem)] py-[clamp(0.5rem,0.7vw,0.9rem)] text-left font-sans text-[clamp(0.9rem,1.05vw,1.2rem)] font-normal leading-[1.3] max-lg:px-[5vw] max-lg:py-[3.4vw] max-lg:text-[clamp(0.95rem,4vw,1.2rem)] ${optionClasses}`}
          role="option"
          aria-selected="false"
          data-select-option
          data-value={option}
        >
          <span
            class={`h-[0.4em] w-[0.4em] shrink-0 rounded-full ${dotClasses}`}
            data-select-dot
            aria-hidden="true"></span>
          {option}
        </button>
      ))
    }
  </div>
</div>
