Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^oferta/?$ https://biuro-mazur.pl/uslugi/ [R=301,L]

RewriteRule ^2026/01/02/ksef-2-0-jak-przygotowac-firme-na-2026-rok/?$ https://biuro-mazur.pl/blog/ksef-w-praktyce/ [R=301,L]
RewriteRule ^wp-content/uploads/2026/01/KSeF-Krajowy-System-e-Faktur-CO-SIEZMIENIA-I-JAK-SIE-PRZYGOTOWAC\.pdf$ https://biuro-mazur.pl/blog/ksef-w-praktyce/ [R=301,L]
RewriteRule ^2025/03/18/podatek-a-przeznaczenie-nieruchomosci/?$ https://biuro-mazur.pl/uslugi/ [R=301,L]
RewriteRule ^2026/0[13]/0[45]/samodzielna-ksiegowa-samodzielny-ksiegowy-debica-stacjonarnie-hybrydowo/?$ https://biuro-mazur.pl/o-nas/ [R=301,L]
RewriteRule ^2026/03/04/praca-mlodsza-ksiegowa-debica/?$ https://biuro-mazur.pl/o-nas/ [R=301,L]

RewriteRule ^20[0-9]{2}/[0-9]{2}/[0-9]{2}/ https://biuro-mazur.pl/blog/ [R=301,L]
RewriteRule ^20[0-9]{2}(/[0-9]{2})?/?$ https://biuro-mazur.pl/blog/ [R=301,L]
RewriteRule ^(category|author|tag|elementor-hf)(/.*)?$ https://biuro-mazur.pl/blog/ [R=301,L]
RewriteRule ^(comments/)?feed/?$ https://biuro-mazur.pl/blog/ [R=301,L]
RewriteRule ^(sitemap|sitemap_index|wp-sitemap|post-sitemap|page-sitemap|category-sitemap|author-sitemap|elementor-hf-sitemap)\.xml$ https://biuro-mazur.pl/sitemap-index.xml [R=301,L]
RewriteRule ^wp-content/uploads/2024/12/Procedura-zgloszen-wewnetrznych-sygnalisci\.pdf$ https://biuro-mazur.pl/documents/whistleblower-procedure.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2024/12/Wzor-formularza-zgloszenia\.pdf$ https://biuro-mazur.pl/documents/whistleblower-report-form.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2024/12/Wzor-potwierdzenia-przyjecia-zgloszenia\.pdf$ https://biuro-mazur.pl/documents/whistleblower-report-confirmation.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2024/12/Wzor-rejestru-zgloszen\.pdf$ https://biuro-mazur.pl/documents/whistleblower-report-register.pdf [R=301,L]
RewriteRule ^wp-content/uploads/ https://biuro-mazur.pl/ [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|login)(/.*)?$ https://biuro-mazur.pl/ [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|author|s)=
RewriteRule ^$ https://biuro-mazur.pl/? [R=301,L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://biuro-mazur.pl/$1/ [R=301,L]

RewriteCond %{HTTP_HOST} !^biuro-mazur\.pl$ [NC]
RewriteRule ^ https://biuro-mazur.pl%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://biuro-mazur.pl%{REQUEST_URI} [R=301,L]
</IfModule>
